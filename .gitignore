# Local virtual environment (recreate with: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt)
.venv/
venv/

# Runtime state: database, signing keys, accounts, quarantine, audit logs — never commit
data/

# Frontend build dependencies (npm install regenerates them; prebuilt output in frontend/dist is committed)
frontend/node_modules/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Logs and local secrets
*.log
.env
rk_test_credentials.txt
