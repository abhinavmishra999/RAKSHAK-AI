# /etc/rakshak/rakshak.env - example settings. Every value here is read by rakshak/config.py.
# Lines starting with # are comments.

# Where Rakshak keeps its database, signing key, reports and scope.yml (mode 0700).
RAKSHAK_DATA=/var/lib/rakshak

# Log files to watch (comma-separated). Supported: nginx/Apache "combined" access logs,
# OpenSSH auth logs (Failed/Accepted password lines) and Rakshak JSON lines.
RAKSHAK_LOGS=/var/log/nginx/access.log,/var/log/auth.log

# recommend = suggest blocks and wait for a person (start here); auto = block high/critical
# rule-based alerts by itself. Switch to auto only after a trial period on your own traffic.
RAKSHAK_MODE=recommend

# Dashboard address. Keep 127.0.0.1 and reach it through SSH tunnel or a TLS reverse proxy.
RAKSHAK_HOST=127.0.0.1
RAKSHAK_PORT=8000
# RAKSHAK_ALLOW_REMOTE=1          # only after TLS + firewall are in front
# RAKSHAK_COOKIE_SECURE=1         # set when the dashboard is served over HTTPS
# RAKSHAK_ALLOWED_HOSTS=soc.example.internal

# Addresses that are never treated as attackers. MUST include this server's own address(es)
# that the website check and Nmap use as source, or Rakshak will flag its own tests.
RAKSHAK_TRUSTED=192.0.2.10
# Addresses Rakshak must never block (gateways, admin jump hosts, monitoring).
RAKSHAK_NEVER_BLOCK=192.0.2.1,192.0.2.20
# Seconds before a block expires (0 = never). Default 86400 (24 h).
RAKSHAK_BLOCK_TTL=86400

# Firewall enforcement: none (record only) | iptables | nftables. See README section 6.
RAKSHAK_ENFORCER=iptables
RAKSHAK_IPTABLES_CMD=sudo -n /usr/local/sbin/rakshak-fw 4
RAKSHAK_IP6TABLES_CMD=sudo -n /usr/local/sbin/rakshak-fw 6
# RAKSHAK_NFT_CMD=sudo -n /usr/sbin/nft     # nftables needs a pre-created table "inet rakshak"

# Your own tool plugins (folder with one sub-folder per tool) and the explicit opt-in.
RAKSHAK_PLUGINS_DIR=/opt/rakshak-plugins
# RAKSHAK_ALLOW_EXTERNAL_PLUGINS=1
# RAKSHAK_TWO_PERSON=1           # the requester can never approve their own test

RAKSHAK_ORG=Example Organisation Pvt Ltd

# Only for a one-time import of existing log history (default: start at the end of each file).
# RAKSHAK_READ_EXISTING=1

# ---- System security (host sensors) ----
# Seconds between host scans (0 turns them off). Default 30.
# RAKSHAK_HOSTSEC_INTERVAL=30
# Extra/comma-separated file-integrity watch paths (defaults cover passwd, shadow,
# group, sudoers, sshd_config and your authorized_keys).
# RAKSHAK_FIM_PATHS=/etc/nginx,/home/deploy/.ssh/authorized_keys
# Hardened account helper used by verified remediation (lock/remove). Strongly
# recommended when the console runs under sudo: the helper refuses uid<1000 and
# the denylist in /usr/local/etc/rakshak-acct-deny. See deploy/rakshak-acct.
# RAKSHAK_ACCT_CMD=sudo -n /usr/local/sbin/rakshak-acct
# Extra account names no remediation may ever lock or remove.
# RAKSHAK_NEVER_LOCK=backup_agent
# Load a previously trained anomaly model file from disk (pickle). Only set this
# for a model file you created yourself on this machine. Default 0: retrain via
# the dashboard instead.
# RAKSHAK_TRUST_MODEL=1

# ---- Settings file (alternative to the environment) ----
# Same KEY=VALUE names as above in a file (env wins on conflict). Defaults:
# ./rakshak.conf then data/rakshak.conf; point elsewhere with:
# RAKSHAK_CONF=/etc/rakshak/rakshak.conf

# ---- Sensor agents on other machines (hub is this console) ----
# On the hub:   python -m rakshak.admin sensor-secret   -> data/sensor_secret.key (mode 600)
# On a sensor:  python -m rakshak.sensor --hub http://HUB:8000 --secret /etc/rakshak/sensor.key
#               [--name web01] [--logs /var/log/nginx/access.log] [--interval 3]
# RAKSHAK_HUB_URL=http://soc.internal:8000
# RAKSHAK_SENSOR_SECRET=/etc/rakshak/sensor.key
